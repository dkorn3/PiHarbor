[Unit]
Description=Raspberry Pi Network Gateway GUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/dominikkornak/PiHarbor
ExecStart=/usr/bin/python3 /home/dominikkornak/PiHarbor/src/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

